#!/usr/bin/env bash
# Live demonstration of detection: switch the probes' fast detector on, then
# slow this machine's network down and restore it.
#
#   scripts/demo on [minutes]   report with the fast detector (default 20 min)
#   scripts/demo off            back to the regular detector only
#   scripts/demo status         is fast detection on, and until when
#   scripts/demo traffic [min]  open a connection every half second, at normal
#                               speed, for min minutes (default 10), so the
#                               probes learn this machine's usual latency
#   scripts/demo quiet          stop that traffic now
#   scripts/demo slow [ms]      add ms (default 40) of delay to this machine's
#                               traffic and keep the connections going, so the
#                               probes see it (sudo)
#   scripts/demo fix            remove the delay; the traffic stops 45 s later
#                               (sudo)
#
# The probes learn about on/off from the ingest's answers, so a switch takes
# up to ~20 s to reach them. The delay is on this machine's default-route
# interface; HEIMDALL_DEMO_IFACE picks another.
set -euo pipefail
PROFILE="${AWS_PROFILE_HEIMDALL:-kgns}"
REGION="${AWS_REGION_HEIMDALL:-eu-central-1}"
PARAM=/heimdall/demo/fast_until
PIDFILE="${TMPDIR:-/tmp}/heimdall-demo-traffic.pid"
TC=/usr/sbin/tc

ssm() { aws ssm "$@" --profile "$PROFILE" --region "$REGION"; }
iface() { echo "${HEIMDALL_DEMO_IFACE:-$(ip route show default | awk '{print $5; exit}')}"; }

stop_traffic() {
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null || true
		rm -f "$PIDFILE"
	fi
}

# Opens a connection every half second for $1 seconds, replacing any
# traffic already running.
start_traffic() {
	local until=$(( $(date +%s) + $1 ))
	stop_traffic
	(while [ "$(date +%s)" -lt "$until" ]; do
		curl -s -o /dev/null --max-time 5 https://www.google.com/generate_204 || true
		sleep 0.5
	done; [ "$(cat "$PIDFILE" 2>/dev/null)" = "$BASHPID" ] && rm -f "$PIDFILE") >/dev/null 2>&1 &
	echo $! >"$PIDFILE"
}

traffic_running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

case "${1:-}" in
on)
	minutes="${2:-20}"
	[[ "$minutes" =~ ^[0-9]+$ ]] && [ "$minutes" -ge 1 ] && [ "$minutes" -le 240 ] ||
		{ echo "minutes must be 1-240" >&2; exit 2; }
	until_ms=$(( ($(date +%s) + minutes * 60) * 1000 ))
	ssm put-parameter --name "$PARAM" --type String --overwrite --value "$until_ms" >/dev/null
	echo "fast detection on until $(date -d "@$((until_ms / 1000))" +%H:%M:%S)"
	# A cold notifier takes seconds longer for its first post.
	aws lambda invoke --profile "$PROFILE" --region "$REGION" --function-name heimdall-notifier \
		--cli-binary-format raw-in-base64-out --payload '{"warmup": true}' /dev/null >/dev/null &&
		echo "notifier warmed up"
	;;
off)
	ssm put-parameter --name "$PARAM" --type String --overwrite --value 0 >/dev/null
	echo "fast detection off"
	;;
status)
	until_ms=$(ssm get-parameter --name "$PARAM" --query Parameter.Value --output text)
	if [ "$until_ms" -gt "$(( $(date +%s) * 1000 ))" ]; then
		echo "fast detection on until $(date -d "@$((until_ms / 1000))" +%H:%M:%S)"
	else
		echo "fast detection off"
	fi
	dev="$(iface)"
	echo "delay on $dev: $($TC qdisc show dev "$dev" root | grep -o 'delay [^ ]*' || echo none)"
	if traffic_running; then echo "traffic running (pid $(cat "$PIDFILE"))"; else echo "no traffic"; fi
	;;
traffic)
	minutes="${2:-10}"
	[[ "$minutes" =~ ^[0-9]+$ ]] && [ "$minutes" -ge 1 ] && [ "$minutes" -le 240 ] ||
		{ echo "minutes must be 1-240" >&2; exit 2; }
	start_traffic $(( minutes * 60 ))
	echo "traffic running for $minutes min (pid $(cat "$PIDFILE")); no delay added"
	;;
quiet)
	stop_traffic
	echo "traffic stopped"
	;;
slow)
	ms="${2:-40}"
	[[ "$ms" =~ ^[0-9]+$ ]] && [ "$ms" -ge 1 ] && [ "$ms" -le 1000 ] || { echo "ms must be 1-1000" >&2; exit 2; }
	dev="$(iface)"
	sudo "$TC" qdisc replace dev "$dev" root netem delay "${ms}ms"
	# Traffic started with `traffic` keeps running; otherwise it runs until
	# `fix` stops it, at most an hour.
	traffic_running || start_traffic 3600
	echo "added ${ms} ms on $dev; traffic running (pid $(cat "$PIDFILE"))"
	;;
fix)
	dev="$(iface)"
	sudo "$TC" qdisc del dev "$dev" root 2>/dev/null || true
	# Keep the traffic a little longer, so the probes see the recovery
	# rather than silence.
	if traffic_running; then
		pid="$(cat "$PIDFILE")"
		(sleep 45; kill "$pid" 2>/dev/null; [ "$(cat "$PIDFILE" 2>/dev/null)" = "$pid" ] && rm -f "$PIDFILE") >/dev/null 2>&1 &
		echo "delay removed on $dev; traffic stops in 45 s"
	else
		echo "delay removed on $dev"
	fi
	;;
*)
	sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
	exit 2
	;;
esac
