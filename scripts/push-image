#!/usr/bin/env bash
# Build a linux/arm64 image and push it to an ECR repository named
# heimdall-*. Called by terraform when an image's sources change.
#   scripts/push-image <repository-url> <tag> <context-dir> [dockerfile]
set -euo pipefail
repo="$1"
tag="$2"
context="$3"
dockerfile="${4:-$context/Dockerfile}"
PROFILE="${AWS_PROFILE_HEIMDALL:-kgns}"
REGION="${AWS_REGION_HEIMDALL:-eu-central-1}"
case "$repo" in
*.dkr.ecr."$REGION".amazonaws.com/heimdall-*) ;;
*)
	echo "refusing to push to $repo" >&2
	exit 1
	;;
esac
# The ECR login goes to a private, temporary Docker config instead of the
# user's credential helper: the helper of Docker Desktop on WSL times out
# when two images are pushed at once, and the short-lived ECR token need
# not outlive this script.
cfg="$(mktemp -d)"
trap 'rm -rf "$cfg"' EXIT
for d in buildx contexts cli-plugins; do
	[ -e "$HOME/.docker/$d" ] && ln -s "$HOME/.docker/$d" "$cfg/$d"
done
echo '{}' >"$cfg/config.json"
export DOCKER_CONFIG="$cfg"
aws ecr get-login-password --profile "$PROFILE" --region "$REGION" |
	docker login --username AWS --password-stdin "${repo%%/*}" >/dev/null 2>&1
# Single-platform image without attestations, so ECR holds one manifest per
# tag and Lambda accepts it.
docker buildx build --platform linux/arm64 --provenance=false --sbom=false \
	--file "$dockerfile" --tag "$repo:$tag" --push "$context"
