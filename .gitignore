# build output
/bin/
/dist/

# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
terraform/*.tfvars
!terraform/*.tfvars.example
/terraform/build/

# local configs that carry tokens or keys
/configs/local/
*.secret.yaml
.env
.env.*

# python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
/cloud/build/
*.zip

# zyee package artifacts (zyee/build.sh writes to dist/); never commit the
# payload, which carries the upload token
/zyee/package/data/opt/
*.ipk

# editors
.idea/
.vscode/
*.swp
