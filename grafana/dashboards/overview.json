  "panels": [
    {
      "type": "table",
      "title": "Services over the range",
      "description": "ICMP echo, TCP connect and HTTPS time to first byte per service. Loss and failure columns are percentages; dsts counts the destination addresses seen.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "athena"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "icmp_p50"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "icmp_p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tcp_p50"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ttfb_p50"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "icmp_loss"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http_fail"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "athena"
          },
          "format": 1,
          "rawSQL": "SELECT category, service, approx_percentile(rtt_ms, 0.5) FILTER (WHERE kind = 'icmp' AND status = 'ok') AS icmp_p50, approx_percentile(rtt_ms, 0.95) FILTER (WHERE kind = 'icmp' AND status = 'ok') AS icmp_p95, 100.0 * count_if(kind = 'icmp' AND status <> 'ok') / nullif(count_if(kind = 'icmp'), 0) AS icmp_loss, approx_percentile(rtt_ms, 0.5) FILTER (WHERE kind = 'tcp' AND status = 'ok') AS tcp_p50, approx_percentile(CAST(json_extract_scalar(extra, '$.ttfb_ms') AS double), 0.5) FILTER (WHERE kind = 'http' AND status = 'ok') AS ttfb_p50, 100.0 * count_if(kind = 'http' AND status <> 'ok') / nullif(count_if(kind = 'http'), 0) AS http_fail, count(DISTINCT dst_ip) AS dsts FROM heimdall.samples WHERE device = '$device' AND dt BETWEEN $__rawTimeFrom('yyyy-MM-dd') AND $__rawTimeTo('yyyy-MM-dd') AND ts_ms BETWEEN ${__from} AND ${__to} AND kind IN ('icmp', 'tcp', 'http') AND category NOT IN ('infra', 'home') GROUP BY 1, 2 ORDER BY 1, 2",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Relative ICMP RTT by category",
      "description": "1.0 is each destination's median over the range. Categories rising together point at the access network; one category alone at its services' paths.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "athena"
      },
      "interval": "1m",
      "maxDataPoints": 400,
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "displayName": "${__field.labels.metric}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "athena"
          },
          "format": 0,
          "rawSQL": "WITH s AS ( SELECT category AS metric, service, dst_ip, CAST(from_unixtime((ts_ms / $__interval_ms) * $__interval_ms / 1000.0) AS timestamp) AS time, rtt_ms FROM heimdall.samples WHERE device = '$device' AND dt BETWEEN $__rawTimeFrom('yyyy-MM-dd') AND $__rawTimeTo('yyyy-MM-dd') AND ts_ms BETWEEN ${__from} AND ${__to} AND kind = 'icmp' AND status = 'ok' AND category NOT IN ('infra', 'home') ), b AS (SELECT service, dst_ip, approx_percentile(rtt_ms, 0.5) AS base FROM s GROUP BY 1, 2) SELECT s.time, s.metric, approx_percentile(s.rtt_ms / b.base, 0.5) AS value FROM s JOIN b ON s.service = b.service AND s.dst_ip = b.dst_ip WHERE b.base > 0 GROUP BY 1, 2 ORDER BY 1",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "id": 2
    },
