          "format": 1,
          "rawSQL": "SELECT service, arbitrary(json_extract_scalar(extra, '$.endpoint')) AS endpoint, dst_ip, kind, approx_percentile(rtt_ms, 0.5) FILTER (WHERE status = 'ok') AS p50, approx_percentile(rtt_ms, 0.95) FILTER (WHERE status = 'ok') AS p95, 100.0 * count_if(status <> 'ok') / count(*) AS no_answer FROM heimdall.samples WHERE device = '$device' AND dt BETWEEN $__rawTimeFrom('yyyy-MM-dd') AND $__rawTimeTo('yyyy-MM-dd') AND ts_ms BETWEEN ${__from} AND ${__to} AND kind IN ('icmp', 'tcp', 'udp_echo', 'stun') AND json_extract_scalar(extra, '$.endpoint') IS NOT NULL GROUP BY service, dst_ip, kind ORDER BY service, p50",
