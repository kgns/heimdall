      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "athena"
          },
          "format": 1,
          "rawSQL": "SELECT target_id AS client, arbitrary(json_extract_scalar(extra, '$.medium')) AS medium, arbitrary(json_extract_scalar(extra, '$.port')) AS port, approx_percentile(rtt_ms, 0.5) FILTER (WHERE status = 'ok') AS rtt_p50, approx_percentile(rtt_ms, 0.95) FILTER (WHERE status = 'ok') AS rtt_p95, 100.0 * count_if(status <> 'ok') / count(*) AS no_answer FROM heimdall.samples WHERE device = '$device' AND dt BETWEEN $__rawTimeFrom('yyyy-MM-dd') AND $__rawTimeTo('yyyy-MM-dd') AND ts_ms BETWEEN ${__from} AND ${__to} AND kind = 'lan' GROUP BY 1 ORDER BY rtt_p95 DESC",
