    {
      "type": "table",
      "title": "LAN clients",
      "description": "Sleeping Wi-Fi devices answer late or not at all; that is power saving, not a network problem.",
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "athena"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rtt_p50"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rtt_p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "no_answer"
            },
            "properties": [
